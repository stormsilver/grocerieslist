{
  "name": "app",
  "private": true,
  "scripts": {
    "build": "bun bun.config.js",
    "build:css:compile": "sass ./app/assets/stylesheets/application.bootstrap.scss:./app/assets/builds/application.css --no-source-map --load-path=node_modules",
    "build:css:prefix": "postcss ./app/assets/builds/application.css --use=autoprefixer --output=./app/assets/builds/application.css",
    "build:css": "bun build:css:compile && bun build:css:prefix",
    "watch:css": "nodemon --watch ./app/assets/stylesheets/ --ext scss --exec \"bun build:css\"",
    "test": "vitest --config vitest.config.mjs",
    "test:watch": "vitest --config vitest.config.mjs --watch",
    "test:coverage": "vitest --config vitest.config.mjs --coverage --run"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/modifiers": "^7.0.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@popperjs/core": "^2.11.8",
    "@tanstack/react-query": "^5.22.2",
    "@tanstack/react-query-devtools": "^5.24.1",
    "autoprefixer": "^10.4.17",
    "baseline-browser-mapping": "^2.9.19",
    "bootstrap": "^5.3.2",
    "bootstrap-icons": "^1.11.3",
    "caniuse-lite": "^1.0.30001770",
    "classnames": "^2.5.1",
    "nodemon": "^3.0.3",
    "postcss": "^8.4.35",
    "postcss-cli": "^11.0.0",
    "react": "^18.2.0",
    "react-bootstrap": "^2.10.1",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.1",
    "sass": "^1.71.0",
    "usehooks-ts": "^2.15.1"
  },
  "browserslist": [
    "defaults"
  ],
  "devDependencies": {
    "eslint": "^8.56.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.5",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@testing-library/user-event": "^14.5.2",
    "@vitest/coverage-v8": "^1.6.1",
    "@vitejs/plugin-react": "^4.2.1",
    "happy-dom": "^13.6.2",
    "vitest": "^1.3.1"
  }
}
